# Переменные docker-compose (контейнерный стек api + db).
# Скопируй в .env рядом с docker-compose.yml и подставь свои значения.
# Хост-версии (PM2 + хост-Postgres) этот файл не касается — её конфиг в server/.env.

POSTGRES_USER=pixisnake
# без спецсимволов :/@ — пароль подставляется в DATABASE_URL как есть
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pixisnake
